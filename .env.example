# AI Research Agent Environment Configuration

APP_ENV=development
MOCK_MODE=true
LOG_LEVEL=INFO

# Backend API
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_research_agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_research_agent

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Providers (optional if MOCK_MODE=true)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Search Providers (optional if MOCK_MODE=true)
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
SEARXNG_BASE_URL=

# Agent Execution Limits
MAX_SEARCH_QUERIES=20
MAX_SOURCES=30
MAX_FOLLOW_UP_SEARCHES=3
MAX_AGENT_STEPS=50
MAX_RUNTIME_SECONDS=300
