# AI Research Agent configuration.
# Copy to .env (start.sh / start.bat do it for you). Real environment
# variables always take precedence over this file.
#
# With the defaults below the app runs in DEMO MODE: offline mock providers,
# no API key needed. Set LLM_PROVIDER and SEARCH_PROVIDER for real research.

APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------- LLM
# mock | openai | anthropic | gemini | groq | openrouter | ollama
LLM_PROVIDER=mock
# Empty = provider default: openai gpt-4o-mini, anthropic claude-sonnet-5-5,
# gemini gemini-2.5-flash, groq llama-3.3-70b-versatile, ollama llama3.1
LLM_MODEL=
# Custom endpoint for OpenAI-compatible servers (LM Studio, vLLM, a proxy...)
LLM_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Claude only: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------- Search
# mock | tavily | searxng | duckduckgo | wikipedia | arxiv
# Combine several with commas, e.g. "tavily,arxiv" or "wikipedia,duckduckgo".
# wikipedia, arxiv and duckduckgo need no key.
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
# Your SearXNG instance (JSON output must be enabled in its settings.yml)
SEARXNG_BASE_URL=
WIKIPEDIA_LANG=en

# Forces the demo providers even when real ones are configured.
MOCK_MODE=false
# Simulated latency of the demo providers (seconds), to watch the pipeline live.
MOCK_LATENCY_SECONDS=0.8

# ----------------------------------------------------------- Storage
# Default: SQLite file apps/api/research_agent.db (nothing to install).
# docker compose sets PostgreSQL and Redis automatically.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_research_agent
# Optional cache for search results and fetched pages (in-memory otherwise).
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------- Limits
MAX_SEARCH_QUERIES=6
MAX_SOURCES=30
MAX_FOLLOW_UP_SEARCHES=3
MAX_RUNTIME_SECONDS=600
MAX_CONCURRENT_FETCHES=5
FETCH_TIMEOUT_SECONDS=12
# Never enable on a server: lets the page fetcher reach private networks.
FETCH_ALLOW_PRIVATE_NETWORKS=false

# ------------------------------------------------------ Web / network
# Browser origins allowed to call the API directly (the web app itself uses
# its built-in same-origin proxy and does not need CORS).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# docker compose only
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_research_agent
WEB_PORT=3000
# Host binding of the API port (loopback by default; the web app proxies /api)
API_PORT=127.0.0.1:8000
